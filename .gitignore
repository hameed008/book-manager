# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (ignores node_modules in BOTH client and server)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (frontend)
.next/
out/

# production (frontend build and backend dist)
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (ignores env files in BOTH client and server)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts